<% layout('layout/boilerplate') %>
   

    <h1>Edit Your entry</h1>
    <form action="/entries/<%= entries._id %>?_method=PUT " method="post" novalidate class="validated-form">
<div>
<label for="title">  Edit Title</label>
        <input type="text" placeholder="Title" name="entry[title]" id="title" value="<%= entries.title %>"  required  class="form-control"> 
</div>

<div>
<label for="author">Edit Author</label>
        <input type="text" placeholder="author" name="entry[author]" id="author" value="<%= entries.author %>"  required  class="form-control">
</div>
        
<div>
<label for="content">Edit Content</label>
        <input type="text" placeholder="Content" name="entry[content]" id="content" value="<%= entries.content %>"required  class="form-control">
</div>
<div>
<label for="image">Image url</label>
        <input type="text" placeholder="image" name="entry[image]" id="image" value="<%= entries.image%>"  required  class="form-control">
</div>
<div>
<label for="tags">Tag</label>
        <input type="text" placeholder="tags" name="entry[tags]" id="tags" value="<%= entries.tags%>"  required  class="form-control">
</div>
<div>
<label for="verse">Edit Scripture</label>
        <input type="text" placeholder="verse" name="entry[verse]" id="verse" value="<%= entries.verse %>"  required  class="form-control">
</div>
<div>
<input type="checkbox" name="entry[isPublic]" id="isPublic" <%= entries.isPublic ? 'checked' : '' %>>
<label for="isPublic">Make this entry public</label>
</div>
        
        <button>Update </button>
    </form>

     <footer>
    <a href="/entries/<%= entries._id %>">back to Entry</a>
  </footer>