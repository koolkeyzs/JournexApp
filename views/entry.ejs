
   <% layout('layout/boilerplate') %>
   
   
   <h1> All Journal Entries</h1>
    <div><a href="entries/new" class="btn btn-primary"> Add new Entry</a></div>

  
   <% for (let entry of entries){ %>

<div class="card mb-3">
  <div class="row">
    <div class="col-md-4">
      <img class="img-fluid" src="<%= entry.image %>">
    </div>

    <div class="col-md-8">
      <div class="card-body">
        <h5 class="card-title"><%= entry.title %></h5>
       <p class="card-text"><%= entry.verse %></p>
       <a class="btn btn-primary" href="/entries/<%= entry._id %>"> View <%= entry.title %></a>
      </div>
    </div>
  </div>
 
  </div>


<% } %>