 <% layout('layout/boilerplate') %>
   
    <h1><%= entries.title %></h1> 
  <h2><%= entries.content %></h2>
    <h3><%= entries.verse %></h3>
    <div class="row">
      <div class="col-6">


        <div id="carouselExample" class="carousel slide">
  <div class="carousel-inner">
 <% entries.images.forEach((img , i) =>{ %>
    <div class="carousel-item <%= i === 0 ? 'active' : ''  %>">
      <img src="<%= img.url %>" class="d-block w-100" alt="">
    </div>
     <% }) %>
  </div>

  <% if(entries.images.length > 1){ %>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
  <% } %>
</div>

 

   
    </div>
    </div>
 </div>
 <% if(entries.tags && entries.tags.length > 0){ %>

<h4>
  #<%= entries.tags[0].toUpperCase() %>
  #<%= entries.tags[1]?.toUpperCase() %>
</h4>

<% } %>

<div>
<% if(currentUser && entries.author && entries.author._id.equals(currentUser._id)) {%>
  <form action="/entries/<%= entries._id %>?_method=DELETE" method="post">
    <button>Delete</button>
  </form>

  <p><a href="/entries/<%= entries._id %>/edit">Edit Entry</a></p>
<% } %>


<% if(entries.author) { %>
  <p>Posted by: <%= entries.author.username %></p>
<% } %>
     <a href="/dashboard">dashboard</a>




<!-- <h2>Leave a Comment</h2> -->

<% if(currentUser) {%>
  <form action="/entries/<%= entries._id %>/comments" method="post" novalidate class="validated-form">
     <label for="body" class="form-label">Comments</label>
  <textarea name="comment[text]" id="body" cols="30"  rows="" class="form-control " required> </textarea>
  <div class="valid-feedback">
    looks good
  </div>
  <button>Submit</button>
  </form>
  <% } %>
 <% for(let comment of entries.comment){%>
<div class="card mb-3">
 
<div class=" card-body">
  <h6>by: <%= comment.author.username %></h6>
    <p>Comment:<%= comment.text %></p>
    <% if(currentUser && comment.author && comment.author._id.equals(currentUser._id)) {%>
    <form action="/entries/<%= entries._id %>/comments/<%= comment._id %>?_method=DELETE" method="post" >
<button>Delete</button>
    </form>
    <% } %>
  </div>
  </div>
  <%} %>






