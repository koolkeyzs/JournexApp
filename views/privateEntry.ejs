<% layout('layout/boilerplate') %>
   
   
   <h1 class="mb-4"> My Private Entries</h1>

  <% if( entries.length === 0){ %>
<p>No private entry yet</p>
<% } %>

  <% for (let entry of entries){ %>

<div class="card mb-3">
  <div class="row">
    <% if(entry.images && entry.images.length > 0){ %>
    <div class="col-md-4">
      
      <img class="img-fluid" src="<%= entry.images[0].url %>">
   
    </div>
       <% } %>

    <div class="col-md-8">
      <div class="card-body">
        <h5 class="card-title"><%= entry.title %></h5>
       <p class="card-text"><%= entry.verse %></p>
       <a class="btn btn-primary" href="/entries/<%= entry._id %>"> View  <%= entry.title %></a>
      </div>
    </div>
  </div>
 
  </div>


<% } %>